# ===== Database =====
# 本地开发(backend 跑在宿主,db 容器):主机名 localhost
# 全容器模式(backend 在容器内):主机名 db
DATABASE_URL=postgresql+asyncpg://llm:llm@localhost:5432/llm
CHECKPOINT_DB_DSN=postgresql://llm:llm@localhost:5432/llm

# ===== 内置供应商(模型分组显示为「内置模型」) =====
# 任意 OpenAI 兼容端点;OPENAI_API_KEY 留空则分组置灰不可用
# BUILTIN_MODELS 决定该分组展示哪些模型,格式:模型名[:输入上下文[:输出上下文]],逗号分隔
# (上下文数值用于上下文使用率圆圈与自动压缩阈值;只写一个数字时视为输入上下文)
# 其余平台请在 WebUI「设置 → 供应商」内添加(手动录入模型名 + 输入/输出上下文)
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_API_BASE=https://api.openai.com/v1
# DEFAULT_MODEL=deepseek-v4.1-flash
# BUILTIN_MODELS=deepseek-v4.1-flash:1000000:384000,glm-5.3-flash:1000000:128000,qwen3.8-flash:1000000:131072

# ===== 静态产物保留策略(图片 / spill / 上传) =====
# 这三类目录都是"用一次留一份":超过天数或总量上限会被自动清理(见 app/services/retention.py)。
# 0 表示关闭该条规则。想留着历史截图/落盘结果做排查,就把天数调大。
# ASSET_RETENTION_DAYS=7
# ASSET_MAX_TOTAL_MB=256

# ===== 安全 =====
# 生产环境务必修改为强随机字符串
# JWT_SECRET=your-strong-random-secret

# ===== 联网搜索(Tavily) =====
# https://tavily.com 注册获取;不填则 web_search 返回"未配置"提示,web_fetch 仍可用
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx

# ===== 可选调优 =====
# CODE_EXEC_TIMEOUT=60
# HISTORY_REPLAY_LIMIT=50
# Agent 单轮最大步数(LangGraph recursion_limit)。每个工具动作约消耗 5 个 superstep
# (中间件钩子各自是节点),所以本值要显著大于 COMPUTER_USE_MAX_ACTIONS(40 → 约 200 步);
# 调太小会出现 "Recursion limit ... reached" 报错。真正的第一道闸是循环守卫与动作上限
# AGENT_RECURSION_LIMIT=300
# 工具循环守卫:最近 W 次工具调用里,同名同参且结果相同的调用达到 K 次就跳过并提示模型换策略
# TOOL_LOOP_GUARD_WINDOW=12
# TOOL_LOOP_GUARD_REPEATS=3

# ===== computer use(模型操作电脑:截屏 + 鼠标键盘) =====
# 仅「全部权限」档位装配该工具;每轮首次调用弹一次审批卡,之后连续动作不再打断。
# 前提:运行环境有图形桌面,且已安装 pyautogui(uv pip install pyautogui);
#      模型必须支持图像输入(纯文本模型会报 "Model only supports text input")。
# COMPUTER_USE_ENABLED=1
# 单轮动作上限(含每次截图),防止屏幕操作死循环;动作最小间隔(秒)
# COMPUTER_USE_MAX_ACTIONS=40
# COMPUTER_USE_ACTION_INTERVAL=0.4
# 截图缩放宽度:它同时就是模型看到并给出坐标的坐标空间
# COMPUTER_USE_MAX_IMAGE_WIDTH=1280
# COMPUTER_USE_IMAGE_FORMAT=jpeg
# COMPUTER_USE_JPEG_QUALITY=80
